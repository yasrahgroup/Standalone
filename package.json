{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "build:public": "node scripts/prepare-public-api.mjs && vite build",
    "build:cms": "node scripts/prepare-cms-api.mjs && vite build --outDir dist-cms",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-cms server.js",
    "typecheck": "tsc --noEmit",
    "lint:boundaries": "node scripts/lint-runtime-boundaries.mjs",
    "lint": "npm run lint:boundaries && npm run typecheck",
    "generate:config": "npx tsx scripts/generate-host-config.mjs",
    "db:migrate": "npx tsx scripts/db-migrate.mjs",
    "db:seed": "npx tsx scripts/db-seed.mjs",
    "build:cf": "npm run build",
    "preview:cf": "npx wrangler dev",
    "deploy:cf": "npx wrangler deploy",
    "test": "node --import tsx --test tests/phase3/phase3.test.ts tests/production-regression.test.ts tests/cms-functionality.test.ts tests/cloudflare-worker.test.ts tests/email-workflow.test.ts tests/login-auth-flow.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@headlessui/react": "^2.2.10",
    "@neondatabase/serverless": "^1.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/multer": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "aws4fetch": "^1.0.20",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "framer-motion": "^14.9.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.5.0",
    "otpauth": "^9.6.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-helmet-async": "^3.0.0",
    "react-phone-number-input": "^3.4.18",
    "react-router-dom": "^7.18.5",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "wrangler": "^3.114.0"
  }
}
