# ==============================================================================
# Azaroth Public Site Staging Deployment Environment Variables (azaroth-tech-hive-test.vercel.app)
# ==============================================================================

# Node Environment
NODE_ENV=production

# Database (Neon PostgreSQL) - Read-Only Content & Form Submission Access (STAGING)
DATABASE_URL_PUBLIC_RO=postgres://readonly:password@ep-xxx.aws.neon.tech/azaroth_staging?sslmode=require
DATABASE_URL_APP=postgres://app_user:password@ep-xxx.aws.neon.tech/azaroth_staging?sslmode=require

# Email Provider (Required for transactional contact & RFQ notification emails)
EMAIL_PROVIDER=BREVO
BREVO_API_KEY=xkeysib-your-brevo-api-key
EMAIL_FROM=hello@azaroth-techhive.com
NOTIFY_EMAIL=hello@azaroth-techhive.com

# Cloudflare R2 Storage - Read-Only Access
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_PUBLIC_BUCKET=azaroth-public-media
R2_PUBLIC_BASE_URL=https://pub-<bucket-id>.r2.dev

# CMS API URL (for fetching content)
CMS_API_URL=https://azaroth-tech-hive-cms-testing.vercel.app

# Site Configuration
SITE_URL=https://azaroth-tech-hive-test.vercel.app

# Health & Monitoring
HEALTH_READY_SECRET=<random-secret-for-health-checks>
